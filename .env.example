## DATABASE
DATABASE_NAME="conmomet_db"
DATABASE_HOST="localhost"
DATABASE_USER="root"
DATABASE_PASS="root"

## DATABASE DE TEST — misma instancia local de MySQL que DATABASE_* arriba (no hace falta
## Docker), pero una base distinta: la suite (scripts/resetTestDb.js) le hace DROP DATABASE y
## TRUNCATE, y nunca tiene que tocar la de desarrollo ni (mucho menos) un host remoto.
## Si trabajás con un DATABASE_URL_STAGING o similar en tu .env para otra cosa (p. ej. mirar el
## ambiente de staging de Railway), es OTRA variable — no reusar ese nombre acá.
LOCAL_TEST_DATABASE_URL="mysql://root@127.0.0.1:3306/api_conmomet_test"

## ADMIN
ADMIN_PASSWORD="123456"
ADMIN_NAME="admin"
ADMIN_LASTNAME="admin"
ADMIN_EMAIL="admin@mail.com"
ADMIN_CUIT=11111111111
ADMIN_PHONE="1111111111"
ADMIN_CELPHONE="111111111"

#EMAIL SERVICE
EMAIL_SERVICE_URL=
EMAIL_SERVICE_TOKEN=
EMAIL_SERVICE_TEMPLETE_ID_CONTACT_FORM=
CONTACT_FORM_RECIPIENT_EMAIL=
EMAIL_SERVICE_TEMPLATE_ID_INVITATION=

#EMPLOYEE INVITATIONS (link público que recibe el empleado)
FRONTEND_URL="http://localhost:3000"

# BYPASS DE PRUEBAS LOCALES — con esto en "true", las invitaciones (mail y WhatsApp) SIEMPRE
# van a estos destinos de prueba, nunca al contacto real del empleado. Dejar en "false" en
# producción.
TEST_NOTIFICATIONS_ENABLED=false
TEST_NOTIFICATIONS_EMAIL=
TEST_NOTIFICATIONS_PHONE=
#WEB PUSH (VAPID) — generar UNA sola vez con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# y nunca regenerar en producción: invalida todas las suscripciones existentes sin dar error.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ALMACENAMIENTO DE ARCHIVOS (Cloudflare R2) — el bucket es PRIVADO: los archivos se abren con URLs
# firmadas que genera el backend (FLOWS.md §57), nunca por una URL pública.
# Dos buckets distintos (local/test vs. producción) no deben compartir credenciales.
# STORAGE_BUCKET: nombre del bucket (sin dominio ni "/").
STORAGE_BUCKET=
# STORAGE_R2_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (sin el nombre del bucket al final).
STORAGE_R2_ENDPOINT=
# Credenciales S3 de R2 (R2 > Manage API tokens): permisos de lectura y escritura SOLO sobre ese bucket.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL: prefijo "canónico" con el que se guardan las URLs en la base
# (<STORAGE_PUBLIC_URL>/<carpeta>/<uuid>.<ext>). Ya NO tiene que abrir en un navegador: con el bucket
# privado es solo un identificador. NO cambiarlo en un ambiente con datos, o las URLs ya guardadas
# dejan de coincidir con el prefijo (igual se resuelven por su path, pero deja de ser consistente).
STORAGE_PUBLIC_URL=

# ARCA (facturación electrónica) — PLAN_ARCA.md §4b, FLOWS.md §64. El certificado y la clave NUNCA van en el repo ni
# en la imagen de Docker: se leen de acá al arrancar.
# ARCA_ENV: "homologacion" o "produccion". SIN VALOR = integración apagada (no se ofrece "Emitir en ARCA").
#   Staging/Railway de pruebas: SIEMPRE homologacion. Solo la imagen de producción lleva "produccion".
ARCA_ENV=
# ARCA_CUIT: CUIT EMISOR (el que va en el Auth de cada pedido y en el QR). Coincide con el dueño del certificado, salvo
#   con delegación, donde es el CUIT representado. 11 dígitos, sin guiones.
ARCA_CUIT=
# Certificado y clave, de UNA de estas dos formas (si hay *_B64, gana sobre *_PATH):
#  - Local: ruta a los archivos.
ARCA_CERT_PATH=
ARCA_KEY_PATH=
#  - Railway / Docker: contenido en base64, en UNA línea (el PEM tiene saltos de línea que las interfaces de variables
#    suelen romper). macOS: base64 -i archivo.crt | tr -d '\n' | pbcopy   ·   Linux: base64 -w0 archivo.crt
#    En Railway, cargar la clave como variable sellada. En Docker, pasarlas en tiempo de ejecución (--env-file / Variables),
#    nunca con ENV ni ARG en el Dockerfile.
ARCA_CERT_B64=
ARCA_KEY_B64=

# Seguridad (FLOWS.md §75.2)
# CRON_SECRET: secret que tiene que mandar quien llame a POST /cron/check-expirations (header "Authorization: Bearer <valor>").
#   SIN VALOR el endpoint queda cerrado (503). Usar un valor aleatorio largo (ej. openssl rand -hex 32).
CRON_SECRET=
# Opcionales: máximos de intentos FALLIDOS de login cada 15 min. Por IP+email (default 5) y solo por IP (default 30).
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_IP_MAX=
