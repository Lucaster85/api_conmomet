## DATABASE
DATABASE_NAME="conmomet_db"
DATABASE_HOST="localhost"
DATABASE_USER="root"
DATABASE_PASS="root"

## DATABASE DE TEST — misma instancia local de MySQL que DATABASE_* arriba (no hace falta
## Docker), pero una base distinta: la suite (scripts/resetTestDb.js) le hace DROP DATABASE y
## TRUNCATE, y nunca tiene que tocar la de desarrollo ni (mucho menos) un host remoto.
## Si trabajás con un DATABASE_URL_STAGING o similar en tu .env para otra cosa (p. ej. mirar el
## ambiente de staging de Railway), es OTRA variable — no reusar ese nombre acá.
LOCAL_TEST_DATABASE_URL="mysql://root@127.0.0.1:3306/api_conmomet_test"

## ADMIN
ADMIN_PASSWORD="123456"
ADMIN_NAME="admin"
ADMIN_LASTNAME="admin"
ADMIN_EMAIL="admin@mail.com"
ADMIN_CUIT=11111111111
ADMIN_PHONE="1111111111"
ADMIN_CELPHONE="1111111111"

#EMAIL SERVICE
EMAIL_SERVICE_URL=
EMAIL_SERVICE_TOKEN=
EMAIL_SERVICE_TEMPLETE_ID_CONTACT_FORM=
CONTACT_FORM_RECIPIENT_EMAIL=
EMAIL_SERVICE_TEMPLATE_ID_INVITATION=

#EMPLOYEE INVITATIONS (link público que recibe el empleado)
FRONTEND_URL="http://localhost:3000"

# BYPASS DE PRUEBAS LOCALES — con esto en "true", las invitaciones (mail y WhatsApp) SIEMPRE
# van a estos destinos de prueba, nunca al contacto real del empleado. Dejar en "false" en
# producción.
TEST_NOTIFICATIONS_ENABLED=false
TEST_NOTIFICATIONS_EMAIL=
TEST_NOTIFICATIONS_PHONE=
#WEB PUSH (VAPID) — generar UNA sola vez con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# y nunca regenerar en producción: invalida todas las suscripciones existentes sin dar error.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
